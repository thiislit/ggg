{
  // Solo para comprobar tipos (editor y `npm run typecheck`); no compila nada.
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // strict desactivado: el código es JavaScript sin anotaciones y el modo estricto
    // generaba miles de avisos sin valor (any implícitos, null posibles) que tapaban
    // los errores reales. Se puede ir activando por partes más adelante.
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": ["es2022", "dom"],
    "isolatedModules": true
  },
  "include": ["./www/src/**/*.js", "./types/**/*.d.ts"],
  "exclude": ["node_modules", "**/*.test.js", "**/__mocks__/**", "www/assets/**"]
}
